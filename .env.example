# Vault contract for YOUR collection. Each collection gets its own deployment —
# do not copy an address out of someone else's doc. Verify with collectionId().
LOOPERS_VAULT=0x0000000000000000000000000000000000000000

# The NFT contract whose holders the vault pays.
LOOPERS_NFT=0x0000000000000000000000000000000000000000

# Base mainnet. Change if your collection lives elsewhere.
LOOPERS_CHAIN_ID=8453
LOOPERS_RPCS=https://mainnet.base.org,https://base.drpc.org,https://base.llamarpc.com
LOOPERS_EXPLORER=https://base.blockscout.com

# Where the run log lives. Not authoritative — safe to delete.
LOOPERS_STATE=./state.json

# sDURATION in seconds. Read it off your vault; 57600 (16h) is the common value.
LOOPERS_SIGN_SECS=57600

# --- Signing: pick exactly one path ---

# (a) Local key. Use a burner that holds only gas.
LOOPERS_PRIVATE_KEY=

# (b) External signer. Runs as `<cmd> <json>` where json is
#     {"to","chainId","value","data"}; the script scrapes a 0x… hash from stdout.
#     Set LOOPERS_WALLET too, so token discovery knows whose tokens to find.
LOOPERS_SUBMIT_CMD=
LOOPERS_WALLET=
